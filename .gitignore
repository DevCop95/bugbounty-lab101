# ── Pentesting Lab — generated artifacts ────────────────────────────
# Goal: never commit raw scan output, private program notes, or sensitive evidence.
# Publish only manually redacted material outside these directories.

# T3MP3ST integration (separate repo, updated via git pull in t3mp3st/)
t3mp3st/

# Private program scope files and engagement notes (keep README and template tracked)
programs/*.md
!programs/README.md
!programs/_template.md

# Logs and daemons
*.log
auto-scanner/logs/
**/daemon-*.log

# Raw reports, cookies, and credentials must never be committed
bugbounty/reports/
auto-scanner/reports/
reports/
evidence/
**/js_secrets.txt
cookies.txt
*credentials*.md
*credentials*.json
*-keys-*.json

# Local databases and caches
auto-scanner/db/
*.sqlite
*.sqlite3
*.db
.cache/
**/.cache/

# Temporary files
*.tmp
*.pyc
__pycache__/
*.swp
*~
.DS_Store
Thumbs.db

# Directories recreated automatically by scripts (empty)
legacy-vm-practice/vms/
legacy-vm-practice/network/

# Threat intelligence cache is generated locally
auto-scanner/threat-intel/
